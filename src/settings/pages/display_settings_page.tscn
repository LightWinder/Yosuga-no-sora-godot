[sub_resource type="Shader" id="Shader_preview_mask"]
code = "shader_type canvas_item;

uniform float corner_radius = 0.055;

void fragment() {
	vec4 color = COLOR;
	vec2 texture_size = 1.0 / TEXTURE_PIXEL_SIZE;
	vec2 half_size = texture_size * 0.5;
	float radius = corner_radius * min(texture_size.x, texture_size.y);
	vec2 position = abs(UV - vec2(0.5)) * texture_size;
	float distance_to_edge = length(max(position - (half_size - vec2(radius)), vec2(0.0))) - radius;
	color.a *= 1.0 - smoothstep(0.0, 2.0, distance_to_edge);
	COLOR = color;
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_preview_mask"]
shader = SubResource("Shader_preview_mask")
shader_parameter/corner_radius = 0.055

